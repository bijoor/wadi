{
  "name": "wadi-dsl",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A Langium DSL for the Wadi parametric house model — a formalization demo for the parametric-domain-modeling method.",
  "scripts": {
    "langium:generate": "langium generate",
