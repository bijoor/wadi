# Cloudflare R2 credentials for scripts/publish-templates.sh.
# Copy this file to .env.r2 (which is gitignored) and fill in your token.
#
# The API token: dash.cloudflare.com → My Profile → API Tokens → Create Token
# → "R2 Storage" with Edit permission. (wrangler's OAuth login has no R2 scope,
# so a token is required.)

CLOUDFLARE_ACCOUNT_ID=bd52255ceee65acd397aafdf4ef88f8e
CLOUDFLARE_API_TOKEN=paste-your-r2-storage-edit-token-here
BUCKET=wadi-templates
