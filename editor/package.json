{
  "name": "editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /viewer.html",
    "build": "tsc -b && vite build --config vite.viewer.config.ts",
    "build:tauri": "vite build --config vite.viewer.config.ts",
    "lint": "oxlint",
    "preview": "vite preview --config vite.viewer.config.ts",
    "smoke-validate": "tsx scripts/smoke-validate.ts",
    "dump-svgs": "tsx scripts/dump-svgs.mjs",
    "gen-primitives": "tsx scripts/gen-primitives.mjs",
    "gen-primitives:check": "tsx scripts/gen-primitives.mjs --check",
    "parity-primitives": "tsx scripts/parity-primitives.mjs",
    "parity-render": "tsx scripts/parity-render.mjs",
    "parity-all": "npm run parity-render",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.13",
    "@hookform/resolvers": "^5.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "svg2pdf.js": "^2.7.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
