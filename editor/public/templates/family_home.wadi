          "length": 10,
          "height": 100
        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((Front_2.X) + pillarT / 2) - (pillarT) / 2",
            "y": "= ((main.yA) + pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Verandah_Pillar_2",
