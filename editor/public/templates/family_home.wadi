{
  "site": {
    "reference_x": 0,
    "reference_y": 0,
    "plot_length": 520,
    "plot_width": 400,
    "formulas": {
      "plot_width": "=House.W",
      "plot_length": "=House.L"
    }
  },
  "defaults": {
    "floor_height": 100,
    "wall_height": 92,
    "slab_thickness": 8,
    "wall_thickness": 8,
    "formulas": {
      "wall_thickness": "=wallT",
      "slab_thickness": "=wallT",
      "floor_height": "=floorH",
      "wall_height": "=wallH"
    }
  },
  "variables": {
    "floorH": 100,
    "slabH": 8,
    "wallT": 8,
    "wallC": "=2*wallT",
    "wallH": "=floorH-slabH",
    "pillarT": 10,
    "doorW": 32,
    "doorH": 70,
    "doorMargin": "=wallT",
    "winW": 45,
    "winH": 45,
    "winSill": 30,
    "bathWinW": 28,
    "entranceW": 56,
    "rearDoorW": 72,
    "pctLivW": 0.34,
    "minLivW": 140,
    "pctVerandahL": 0.12,
    "minVerandahL": 60,
    "pctBed1L": 0.26,
    "minBed1L": 120,
    "pctBed3L": 0.2,
    "minBed3L": 100,
    "pctKitchenL": 0.22,
    "minKitchenL": 110,
    "pctBathL": 0.13,
    "minBathL": 66,
    "passageL": 40,
    "roof_style": 3,
    "pilInset": "= (pillarT - wallT) / 2"
  },
  "points": {
    "House": {
      "x": 400,
      "y": 520
    },
    "Verandah": {
      "x": "=House.W-wallC",
      "y": "=max(minVerandahL, round(pctVerandahL*House.L))"
    },
    "LivCol": {
      "x": "=max(minLivW, round(pctLivW*House.W))",
      "y": 0
    },
    "BedCol": {
      "x": "=LivCol.W",
      "y": 0
    },
    "MajCol": {
      "x": "=House.W-BedCol.W-LivCol.W-4*wallT",
      "y": 0
    },
    "Bath": {
      "x": "=(LivCol.W-wallT)/2",
      "y": "=max(minBathL, round(pctBathL*House.L))"
    },
    "Passage": {
      "x": "=LivCol.W",
      "y": "=passageL"
    },
    "Bed1": {
      "x": "=BedCol.W",
      "y": "=max(minBed1L, round(pctBed1L*House.L))"
    },
    "Bed3": {
      "x": "=BedCol.W",
      "y": "=max(minBed3L, round(pctBed3L*House.L))"
    },
    "Bed2": {
      "x": "=BedCol.W",
      "y": "=House.L-Verandah.L-Bed1.L-Bed3.L-Bath.L-6*wallT"
    },
    "Kitchen": {
      "x": "=LivCol.W",
      "y": "=max(minKitchenL, round(pctKitchenL*House.L))"
    },
    "Living": {
      "x": "=LivCol.W",
      "y": "=House.L-Verandah.L-Kitchen.L-Passage.L-Bath.L-6*wallT"
    },
    "Majghar": {
      "x": "=MajCol.W",
      "y": "=House.L-Verandah.L-Bath.L-4*wallT"
    },
    "Padvi": {
      "x": "=BedCol.W+MajCol.W+wallT",
      "y": "=Bath.L"
    },
    "Ver_TL": {
      "x": 0,
      "y": 0
    },
    "Ver_BR": {
      "x": "=House.W",
      "y": "=Verandah.L+wallC"
    },
    "Bed1_TL": {
      "x": 0,
      "y": "=Verandah.L+wallT"
    },
    "Bed1_BR": {
      "x": "=BedCol.W+wallC",
      "y": "=Bed1_TL.Y+Bed1.L+wallC"
    },
    "Bed2_TL": {
      "x": 0,
      "y": "=Bed1_TL.Y+Bed1.L+wallT"
    },
    "Bed2_BR": {
      "x": "=BedCol.W+wallC",
      "y": "=Bed2_TL.Y+Bed2.L+wallC"
    },
    "Bed3_TL": {
      "x": 0,
      "y": "=Bed2_TL.Y+Bed2.L+wallT"
    },
    "Bed3_BR": {
      "x": "=BedCol.W+wallC",
      "y": "=House.L-Bath.L-wallT"
    },
    "Maj_TL": {
      "x": "=BedCol.W+wallT",
      "y": "=Verandah.L+wallT"
    },
    "Maj_BR": {
      "x": "=BedCol.W+wallT+MajCol.W+wallC",
      "y": "=House.L-Bath.L-wallT"
    },
    "Liv_TL": {
      "x": "=BedCol.W+MajCol.W+2*wallT",
      "y": "=Verandah.L+wallT"
    },
    "Liv_BR": {
      "x": "=House.W",
      "y": "=Liv_TL.Y+Living.L+wallC"
    },
    "Kit_TL": {
      "x": "=BedCol.W+MajCol.W+2*wallT",
      "y": "=Liv_TL.Y+Living.L+wallT"
    },
    "Kit_BR": {
      "x": "=House.W",
      "y": "=Kit_TL.Y+Kitchen.L+wallC"
    },
    "Pass_TL": {
      "x": "=BedCol.W+MajCol.W+2*wallT",
      "y": "=Kit_TL.Y+Kitchen.L+wallT"
    },
    "Pass_BR": {
      "x": "=House.W",
      "y": "=House.L-Bath.L-wallT"
    },
    "Padvi_TL": {
      "x": 0,
      "y": "=House.L-Bath.L-wallC"
    },
    "Padvi_BR": {
      "x": "=BedCol.W+wallT+MajCol.W+wallC",
      "y": "=House.L"
    },
    "Bath1_TL": {
      "x": "=BedCol.W+MajCol.W+2*wallT",
      "y": "=House.L-Bath.L-wallC"
    },
    "Bath1_BR": {
      "x": "=BedCol.W+MajCol.W+2*wallT+Bath.W+wallC",
      "y": "=House.L"
    },
    "Bath2_TL": {
      "x": "=Bath1_BR.X-wallT",
      "y": "=House.L-Bath.L-wallC"
    },
    "Bath2_BR": {
      "x": "=House.W",
      "y": "=House.L"
    },
    "Front_2": {
      "x": "=House.W/2-entranceW/2-pillarT",
      "y": 0
    },
    "Front_3": {
      "x": "=House.W/2+entranceW/2",
      "y": 0
    },
    "Rear_2": {
      "x": "=(Padvi_TL.X+Padvi_BR.X)/2-rearDoorW/2-pillarT",
      "y": "=House.L-pillarT"
    },
    "Rear_3": {
      "x": "=(Padvi_TL.X+Padvi_BR.X)/2+rearDoorW/2",
      "y": "=House.L-pillarT"
    }
  },
  "configurator": {
    "title": "Configure your family home",
    "description": "Adjust the plot, rooms and construction — the whole house re-flows to fit.",
    "groups": [
      {
        "id": "size",
        "label": "Plot"
      },
      {
        "id": "rooms",
        "label": "Rooms"
      },
      {
        "id": "build",
        "label": "Construction"
      },
      {
        "id": "roof",
        "label": "Roof"
      }
    ],
    "inputs": [
      {
        "target": "House.W",
        "label": "Plot width",
        "description": "Overall east–west width.",
        "unit": "ft",
        "min": 340,
        "max": 520,
        "step": 10,
        "group": "size"
      },
      {
        "target": "House.L",
        "label": "Plot length",
        "description": "Overall north–south length.",
        "unit": "ft",
        "min": 460,
        "max": 640,
        "step": 10,
        "group": "size"
      },
      {
        "target": "pctVerandahL",
        "label": "Verandah depth",
        "description": "Front verandah depth, as a share of the plot length.",
        "unit": "percent",
        "min": 0.1,
        "max": 0.2,
        "step": 0.01,
        "group": "rooms"
      },
      {
        "target": "pctLivW",
        "label": "Side-room width",
        "description": "Bedroom & living column width as a share of the plot.",
        "unit": "percent",
        "min": 0.3,
        "max": 0.4,
        "step": 0.01,
        "group": "rooms"
      },
      {
        "target": "minBathL",
        "label": "Bathroom depth (min)",
        "description": "Smallest the two bathrooms get.",
        "unit": "ft",
        "min": 60,
        "max": 90,
        "step": 2,
        "group": "rooms"
      },
      {
        "target": "floorH",
        "label": "Ceiling height",
        "description": "Floor-to-floor height.",
        "options": [
          {
            "value": 90,
            "label": "9 ft"
          },
          {
            "value": 100,
            "label": "10 ft (standard)"
          },
          {
            "value": 110,
            "label": "11 ft"
          },
          {
            "value": 120,
            "label": "12 ft"
          }
        ],
        "group": "build"
      },
      {
        "target": "wallT",
        "label": "Wall thickness",
        "description": "External wall thickness.",
        "options": [
          {
            "value": 6,
            "label": "Thin"
          },
          {
            "value": 8,
            "label": "Standard"
          },
          {
            "value": 10,
            "label": "Thick"
          }
        ],
        "group": "build"
      },
      {
        "target": "roof_style",
        "label": "Roof style",
        "description": "Choose the roof shape — the model rebuilds to match.",
        "options": [
          {
            "value": 0,
            "label": "Flat"
          },
          {
            "value": 1,
            "label": "Shed"
          },
          {
            "value": 2,
            "label": "Gable"
          },
          {
            "value": 3,
            "label": "Hip"
          }
        ],
        "group": "roof"
      }
    ]
  },
  "thumbnails": [
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,"
  ],
  "grids": {
    "main": {
      "x": [
        {
          "name": "1",
          "at": "= wallT / 2"
        },
        {
          "name": "2",
          "at": "= max(minLivW, round(pctLivW * House.W)) + 3 * wallT / 2"
        },
        {
          "name": "3",
          "at": "= House.W - max(minLivW, round(pctLivW * House.W)) - 3 * wallT / 2"
        },
        {
          "name": "4",
          "at": "= House.W - (max(minLivW, round(pctLivW * House.W)) - wallT) / 2 - 3 * wallT / 2"
        },
        {
          "name": "5",
          "at": "= House.W - wallT / 2"
        }
      ],
      "y": [
        {
          "name": "A",
          "at": "= wallT / 2"
        },
        {
          "name": "B",
          "at": "= max(minVerandahL, round(pctVerandahL * House.L)) + 3 * wallT / 2"
        },
        {
          "name": "C",
          "at": "= max(minVerandahL, round(pctVerandahL * House.L)) + max(minBed1L, round(pctBed1L * House.L)) + 5 * wallT / 2"
        },
        {
          "name": "D",
          "at": "= House.L - max(minBathL, round(pctBathL * House.L)) - passageL - max(minKitchenL, round(pctKitchenL * House.L)) - 7 * wallT / 2"
        },
        {
          "name": "E",
          "at": "= House.L - max(minBathL, round(pctBathL * House.L)) - max(minBed3L, round(pctBed3L * House.L)) - 5 * wallT / 2"
        },
        {
          "name": "F",
          "at": "= House.L - max(minBathL, round(pctBathL * House.L)) - passageL - 5 * wallT / 2"
        },
        {
          "name": "G",
          "at": "= House.L - max(minBathL, round(pctBathL * House.L)) - 3 * wallT / 2"
        },
        {
          "name": "H",
          "at": "= House.L - wallT / 2"
        }
      ]
    }
  },
  "floors": [
    {
      "floor_number": 0,
      "name": "Plinth",
      "height": 30,
      "objects": [
        {
          "type": "ground",
          "formulas": {
            "x": "=Ver_TL.X",
            "y": "=Ver_TL.Y",
            "width": "=House.W",
            "length": "=House.L"
          },
          "layer": "ground",
          "name": "Ground",
          "x": 0,
          "y": 0,
          "width": 400,
          "length": 520
        },
        {
