        {
          "type": "floor_slab",
          "x": 4,
          "y": 4,
          "width": 392,
          "length": 512,
          "formulas": {
            "x": "= main.x1",
            "y": "= main.yA",
            "width": "= main.x5 - main.x1",
            "length": "= main.yH - main.yA"
          }
        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((main.x1) + pilInset) - (pillarT) / 2",
            "y": "= ((main.yA) + pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Verandah_Pillar_1",
          "x": 0,
