            "x": "= ((Front_3.X) + pillarT / 2) - (pillarT) / 2",
            "y": "= ((main.yA) + pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Verandah_Pillar_3",
          "x": 178,
          "y": 0,
          "width": 10,
          "length": 10,
          "height": 100
        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((main.x4) - pilInset) - (pillarT) / 2",
            "y": "= ((main.yA) + pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Verandah_Pillar_4",
          "x": 290,
          "y": 0,
          "width": 10,
          "length": 10,
