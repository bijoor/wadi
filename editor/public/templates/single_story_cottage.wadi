        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((main.x1) + pilInset) - (pillarT) / 2",
            "y": "= ((main.yF) - pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Padvi_Pillar_1",
          "x": 0,
          "y": 450,
          "width": 10,
          "length": 10,
          "height": 100
        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((Rear_2.X) + pillarT / 2) - (pillarT) / 2",
            "y": "= ((main.yF) - pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Padvi_Pillar_2",
          "x": 65,
