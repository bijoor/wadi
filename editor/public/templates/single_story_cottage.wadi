          "y": 4,
          "width": 292,
          "length": 452,
          "formulas": {
            "x": "= main.x1",
            "y": "= main.yA",
            "width": "= main.x4 - main.x1",
            "length": "= main.yF - main.yA"
          }
        },
        {
          "type": "pillar",
          "formulas": {
            "x": "= ((main.x1) + pilInset) - (pillarT) / 2",
            "y": "= ((main.yA) + pilInset) - (pillarT) / 2",
            "width": "=pillarT",
            "length": "=pillarT",
            "height": "=floorH"
          },
          "name": "Verandah_Pillar_1",
