{
  "site": {
    "reference_x": 0,
    "reference_y": 0,
    "plot_length": 460,
    "plot_width": 300,
    "formulas": {
      "plot_width": "=House.W",
      "plot_length": "=House.L"
    }
  },
  "defaults": {
    "floor_height": 100,
    "wall_height": 92,
    "slab_thickness": 8,
    "wall_thickness": 8,
    "formulas": {
      "wall_thickness": "=wallT",
      "slab_thickness": "=wallT",
      "floor_height": "=floorH",
      "wall_height": "=wallH"
    }
  },
  "variables": {
    "floorH": 100,
    "slabH": 8,
    "wallT": 8,
    "wallC": "=2*wallT",
    "wallH": "=floorH-slabH",
    "pillarT": 10,
    "doorW": 32,
    "doorH": 70,
    "doorMargin": "=wallT",
    "winW": 45,
    "winH": 45,
    "winSill": 30,
    "bathWinW": 28,
    "entranceW": 56,
    "rearDoorW": 72,
    "pctVerandahL": 0.15,
    "minVerandahL": 60,
    "pctBedroomW": 0.4,
    "minBedroomW": 100,
    "pctBedroomL": 0.28,
    "minBedroomL": 110,
    "pctKitchenL": 0.2,
    "minKitchenL": 84,
    "pctBathroomW": 0.2,
    "minBathroomW": 70,
    "pctBathroomL": 0.13,
    "minBathroomL": 70,
    "roof_style": 3,
    "pilInset": "= (pillarT - wallT) / 2"
  },
  "points": {
    "House": {
      "x": 300,
      "y": 460
    },
    "Verandah": {
      "x": "=House.W-wallC",
      "y": "=max(minVerandahL, round(pctVerandahL*House.L))"
    },
    "Bedroom": {
      "x": "=max(minBedroomW, round(pctBedroomW*House.W))",
      "y": "=max(minBedroomL, round(pctBedroomL*House.L))"
    },
    "Kitchen": {
      "x": "=Living.W",
      "y": "=max(minKitchenL, round(pctKitchenL*House.L))"
    },
    "Bathroom": {
      "x": "=max(minBathroomW, round(pctBathroomW*House.W))",
      "y": "=max(minBathroomL, round(pctBathroomL*House.L))"
    },
    "Padvi": {
      "x": "=House.W-Bathroom.W-3*wallT",
      "y": "=Bathroom.L"
    },
    "Living": {
      "x": "=House.W-Bedroom.W-3*wallT",
      "y": "=House.L-Verandah.L-Kitchen.L-Padvi.L-5*wallT"
    },
    "Majghar": {
      "x": "=Bedroom.W",
      "y": "=House.L-Verandah.L-Bedroom.L-Bathroom.L-5*wallT"
    },
    "Ver_TL": {
      "x": 0,
      "y": 0
    },
    "Ver_BR": {
      "x": "=House.W",
      "y": "=Verandah.L+wallC"
    },
    "Bed_TL": {
      "x": 0,
      "y": "=Verandah.L+wallT"
    },
    "Bed_BR": {
      "x": "=Bedroom.W+wallC",
      "y": "=Bed_TL.Y+Bedroom.L+wallC"
    },
    "Maj_TL": {
      "x": 0,
      "y": "=Bed_TL.Y+Bedroom.L+wallT"
    },
    "Maj_BR": {
      "x": "=Bedroom.W+wallC",
      "y": "=Maj_TL.Y+Majghar.L+wallC"
    },
    "Liv_TL": {
      "x": "=Bedroom.W+wallT",
      "y": "=Verandah.L+wallT"
    },
    "Liv_BR": {
      "x": "=House.W",
      "y": "=Liv_TL.Y+Living.L+wallC"
    },
    "Kit_TL": {
      "x": "=Bedroom.W+wallT",
      "y": "=Liv_TL.Y+Living.L+wallT"
    },
    "Kit_BR": {
      "x": "=House.W",
      "y": "=Kit_TL.Y+Kitchen.L+wallC"
    },
    "Padvi_TL": {
      "x": 0,
      "y": "=House.L-Padvi.L-wallC"
    },
    "Padvi_BR": {
      "x": "=House.W-Bathroom.W-wallT",
      "y": "=House.L"
    },
    "Bath_TL": {
      "x": "=House.W-Bathroom.W-wallC",
      "y": "=House.L-Padvi.L-wallC"
    },
    "Bath_BR": {
      "x": "=House.W",
      "y": "=House.L"
    },
    "Front_2": {
      "x": "=House.W/2-entranceW/2-pillarT",
      "y": 0
    },
    "Front_3": {
      "x": "=House.W/2+entranceW/2",
      "y": 0
    },
    "Rear_2": {
      "x": "=(Padvi_TL.X+Padvi_BR.X)/2-rearDoorW/2-pillarT",
      "y": "=House.L-pillarT"
    },
    "Rear_3": {
      "x": "=(Padvi_TL.X+Padvi_BR.X)/2+rearDoorW/2",
      "y": "=House.L-pillarT"
    }
  },
  "configurator": {
    "title": "Configure your cottage",
    "description": "Adjust the plot, rooms and construction — the whole house re-flows to fit.",
    "groups": [
      {
        "id": "size",
        "label": "Plot"
      },
      {
        "id": "rooms",
        "label": "Rooms"
      },
      {
        "id": "build",
        "label": "Construction"
      },
      {
        "id": "roof",
        "label": "Roof"
      }
    ],
    "inputs": [
      {
        "target": "House.W",
        "label": "Plot width",
        "description": "Overall east–west width.",
        "unit": "ft",
        "min": 220,
        "max": 400,
        "step": 10,
        "group": "size"
      },
      {
        "target": "House.L",
        "label": "Plot length",
        "description": "Overall north–south length.",
        "unit": "ft",
        "min": 340,
        "max": 560,
        "step": 10,
        "group": "size"
      },
      {
        "target": "pctVerandahL",
        "label": "Verandah depth",
        "description": "Front verandah depth, as a share of the plot length.",
        "unit": "percent",
        "min": 0.1,
        "max": 0.22,
        "step": 0.01,
        "group": "rooms"
      },
      {
        "target": "pctBedroomW",
        "label": "Bedroom width",
        "description": "Bedroom width as a share of the plot width.",
        "unit": "percent",
        "min": 0.3,
        "max": 0.5,
        "step": 0.02,
        "group": "rooms"
      },
      {
        "target": "minBathroomW",
        "label": "Min bathroom size",
        "description": "Smallest the bathroom gets on tight plots.",
        "unit": "ft",
        "min": 54,
        "max": 96,
        "step": 2,
        "group": "rooms"
      },
      {
        "target": "floorH",
        "label": "Ceiling height",
        "description": "Floor-to-floor height.",
        "options": [
          {
            "value": 90,
            "label": "9 ft"
          },
          {
            "value": 100,
            "label": "10 ft (standard)"
          },
          {
            "value": 110,
            "label": "11 ft"
          },
          {
            "value": 120,
            "label": "12 ft"
          }
        ],
        "group": "build"
      },
      {
        "target": "wallT",
        "label": "Wall thickness",
        "description": "External wall thickness.",
        "options": [
          {
            "value": 6,
            "label": "Thin"
          },
          {
            "value": 8,
            "label": "Standard"
          },
          {
            "value": 10,
            "label": "Thick"
          }
        ],
        "group": "build"
      },
      {
        "target": "roof_style",
        "label": "Roof style",
        "description": "Choose the roof shape — the model rebuilds to match.",
        "options": [
          {
            "value": 0,
            "label": "Flat"
          },
          {
            "value": 1,
            "label": "Shed"
          },
          {
            "value": 2,
            "label": "Gable"
          },
          {
            "value": 3,
            "label": "Hip"
          }
        ],
        "group": "roof"
      }
    ]
  },
  "thumbnails": [
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,"
  ],
  "grids": {
    "main": {
      "x": [
        {
          "name": "1",
          "at": "= wallT / 2"
        },
        {
          "name": "2",
          "at": "= max(minBedroomW, round(pctBedroomW * House.W)) + 3 * wallT / 2"
        },
        {
          "name": "3",
          "at": "= House.W - max(minBathroomW, round(pctBathroomW * House.W)) - 3 * wallT / 2"
        },
        {
          "name": "4",
          "at": "= House.W - wallT / 2"
        }
      ],
      "y": [
        {
          "name": "A",
          "at": "= wallT / 2"
        },
        {
          "name": "B",
          "at": "= max(minVerandahL, round(pctVerandahL * House.L)) + 3 * wallT / 2"
        },
        {
          "name": "C",
          "at": "= max(minVerandahL, round(pctVerandahL * House.L)) + max(minBedroomL, round(pctBedroomL * House.L)) + 5 * wallT / 2"
        },
        {
          "name": "D",
          "at": "= House.L - max(minBathroomL, round(pctBathroomL * House.L)) - max(minKitchenL, round(pctKitchenL * House.L)) - 5 * wallT / 2"
        },
        {
          "name": "E",
          "at": "= House.L - max(minBathroomL, round(pctBathroomL * House.L)) - 3 * wallT / 2"
        },
        {
          "name": "F",
          "at": "= House.L - wallT / 2"
        }
      ]
    }
  },
  "template": {
    "title": "Single-story cottage (parametric)",
    "description": "Fully-parametric Konkan cottage: front verandah, bedroom, central hall (Majghar), living, kitchen, bathroom, and a rear Padvi — hip roof. Resize the plot and the rooms re-flow. Default 30 × 46 ft.",
    "style": "Konkan",
    "roof": "Hip",
    "minWidthFt": 22,
    "minLengthFt": 34
  },
  "floors": [
    {
      "floor_number": 0,
      "name": "Plinth",
      "height": 30,
      "objects": [
        {
          "type": "ground",
          "formulas": {
            "x": "=Ver_TL.X",
            "y": "=Ver_TL.Y",
            "width": "=House.W",
            "length": "=House.L"
          },
          "layer": "ground",
          "name": "Ground",
          "x": 0,
          "y": 0,
          "width": 300,
          "length": 460
        },
        {
          "type": "plinth",
          "layer": "plinth",
          "name": "Plinth",
          "x": 4,
          "y": 4,
          "width": 292,
          "length": 452,
          "height": 30,
          "formulas": {
            "x": "= main.x1",
            "y": "= main.yA",
            "width": "= main.x4 - main.x1",
            "length": "= main.yF - main.yA"
          }
        }
      ]
    },
    {
      "floor_number": 1,
      "name": "Ground Floor",
      "objects": [
        {
          "type": "floor_slab",
