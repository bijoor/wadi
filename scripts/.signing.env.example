# Apple code-signing + notarization secrets for a signed macOS release.
#
# Copy this file to  scripts/.signing.env  (gitignored) and fill in your values.
# scripts/release-desktop.sh sources it automatically, and `cargo tauri build` then
# signs AND notarizes the macOS app from these variables — no other flags needed.
#
# Find your signing identity:   security find-identity -v -p codesigning
# Confirm your setup any time:   scripts/check-signing.sh

# The "Developer ID Application" certificate identity (exact string, in quotes).
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization credentials.
export APPLE_ID="you@example.com"
# An APP-SPECIFIC password (NOT your Apple ID login password).
# Create one at appleid.apple.com > Sign-In and Security > App-Specific Passwords.
export APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
# Your 10-character Team ID (the part in parentheses in the identity above).
export APPLE_TEAM_ID="TEAMID"
