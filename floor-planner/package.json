{
  "name": "floor-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test-spans": "node scripts/test-spans.mjs && node scripts/test-span-reflow.mjs && node scripts/test-span-export.mjs",
    "test-furniture": "node scripts/test-furniture-fit.mjs",
    "test-connection-route": "node scripts/test-connection-route.mjs",
    "build-catalog": "node scripts/build-furniture-catalog.mjs",
    "test-layout-wdl": "cd ../editor && npx tsx ../floor-planner/scripts/test-layout-wdl.mjs",
    "check-layouts": "cd ../editor && npx tsx ../floor-planner/scripts/check-room-layouts.mjs",
    "build-layouts": "npm run check-layouts && cd ../editor && npx tsx ../floor-planner/scripts/build-room-layouts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
